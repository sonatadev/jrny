# ATTENZIONE: questo file è pubblico. Non copiarne i valori così come sono:
# ogni segreto lasciato al valore di esempio è noto a chiunque legga il repo.
# Genera i segreti con:  openssl rand -hex 32

POSTGRES_DB=jrny
POSTGRES_USER=tp_user
# Genera: openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://tp_user:LA_PASSWORD_GENERATA@db:5432/jrny

# Genera: openssl rand -hex 32 — il server rifiuta di avviarsi se è
# più corto di 32 caratteri o se è un valore di default noto.
JWT_SECRET=

NODE_ENV=production
PORT=3090

# URL pubblico dell'app (usato nei link delle email)
APP_URL=http://localhost:8090

# SMTP per invio email inviti (lascia vuoto per disabilitare)
# Gmail: host=smtp.gmail.com port=587 user=tuo@gmail.com pass=app-password
# Brevo: host=smtp-relay.brevo.com port=587 user=tuo@email.com pass=api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Chiave Google Places (opzionale): senza, l'import da Maps ricava comunque
# nome, città e coordinate dal link. Limitala per API e per referrer.
GOOGLE_MAPS_API_KEY=
